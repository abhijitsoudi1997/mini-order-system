            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test(\"reservedQuantity is 2\", () => pm.expect(p.reservedQuantity).to.eql(2));",
              "pm.test(\"availableQuantity is 3\", () => pm.expect(p.availableQuantity).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Order for 4 units (only 3 available) -> 409 FAILED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{orderUrl}}/orders",
          "host": [
            "{{orderUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"E2E Tester\",\n  \"customerEmail\": \"{{e2eEmail}}\",\n  \"customerPhone\": \"9876543210\",\n  \"shippingAddress\": {\n    \"line\": \"12 MG Road\",\n    \"city\": \"Mysore\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"570001\"\n  },\n  \"items\": [\n    {\n      \"sku\": \"{{e2eSku}}\",\n      \"quantity\": 4\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
              "const o = pm.response.json();",
              "pm.test(\"status is FAILED\", () => pm.expect(o.status).to.eql(\"FAILED\"));",
              "pm.test(\"failure reason mentions stock\", () => pm.expect(o.failureReason).to.match(/stock/i));",
              "pm.collectionVariables.set(\"failedOrderId\", o.id);"
            ]
          }
        }
      ]
    },
