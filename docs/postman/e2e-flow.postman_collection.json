{
  "info": {
    "name": "mini-order-system E2E flow",
    "description": "End-to-end flow across Inventory (8081) and Order (8082). Start both services, then run the whole collection (Run collection, or: newman run this file). Creates its own test product each run and cleans up at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Inventory health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventoryUrl}}/actuator/health",
          "host": [
            "{{inventoryUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Order health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{orderUrl}}/actuator/health",
          "host": [
            "{{orderUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"status is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create test product (qty 5)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{inventoryUrl}}/products",
          "host": [
            "{{inventoryUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{e2eSku}}\",\n  \"name\": \"E2E Widget\",\n  \"category\": \"E2E\",\n  \"price\": 100.0,\n  \"quantity\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// fresh data for every run, so the flow can be repeated",
              "pm.collectionVariables.set(\"e2eSku\", \"SKU-E2E-\" + Date.now());",
              "pm.collectionVariables.set(\"e2eEmail\", \"e2e-\" + Date.now() + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Location header present\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);",
              "const p = pm.response.json();",
              "pm.test(\"sku matches\", () => pm.expect(p.sku).to.eql(pm.collectionVariables.get(\"e2eSku\")));",
              "pm.collectionVariables.set(\"productId\", p.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Product starts with nothing reserved",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventoryUrl}}/products/sku/{{e2eSku}}",
          "host": [
            "{{inventoryUrl}}"
          ],
          "path": [
            "products",
            "sku",
            "{{e2eSku}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "pm.test(\"reservedQuantity is 0\", () => pm.expect(p.reservedQuantity).to.eql(0));",
              "pm.test(\"availableQuantity is 5\", () => pm.expect(p.availableQuantity).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Place order for 2 units -> CONFIRMED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{orderUrl}}/orders",
          "host": [
            "{{orderUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"E2E Tester\",\n  \"customerEmail\": \"{{e2eEmail}}\",\n  \"customerPhone\": \"9876543210\",\n  \"shippingAddress\": {\n    \"line\": \"12 MG Road\",\n    \"city\": \"Mysore\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"570001\"\n  },\n  \"items\": [\n    {\n      \"sku\": \"{{e2eSku}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Location header present\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);",
              "const o = pm.response.json();",
              "pm.test(\"status is CONFIRMED\", () => pm.expect(o.status).to.eql(\"CONFIRMED\"));",
              "pm.test(\"no failure reason\", () => pm.expect(o.failureReason == null).to.be.true);",
              "pm.test(\"order number looks right\", () => pm.expect(o.orderNumber).to.match(/^ORD-/));",
              "pm.test(\"total is 2 x 100.00\", () => pm.expect(Number(o.totalAmount)).to.eql(200));",
              "pm.collectionVariables.set(\"orderId\", o.id);",
              "pm.collectionVariables.set(\"orderNumber\", o.orderNumber);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Inventory now holds 2 for the order",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventoryUrl}}/products/sku/{{e2eSku}}",
          "host": [
            "{{inventoryUrl}}"
